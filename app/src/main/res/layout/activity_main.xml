<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.eagertolearn.bookscanner.ui.CameraXPreviewView
        android:id="@+id/cameraPreviewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/warningBannerText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#CCBF360C"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/resource_warning_banner"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/telemetryBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="#99000000"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/warningBannerText">

        <TextView
            android:id="@+id/bookVolumeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/default_volume_header"
            android:textColor="#E0E0E0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/resourceTelemetryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/default_resource_telemetry"
            android:textColor="#81C784"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/captureStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/default_capture_status"
            android:textColor="#64B5F6"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/controlsPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/captureShotButton"
            android:layout_width="160dp"
            android:layout_height="56dp"
            android:text="@string/capture_spread_shot" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/forceCompleteButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="160dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/complete_spread"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sessionSettingsButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="160dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="@string/session_settings"
            android:textColor="#FFFFFF" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/lanFallbackSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:checked="true"
            android:text="@string/lan_fallback_label"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
